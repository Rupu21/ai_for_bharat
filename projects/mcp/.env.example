# API Configuration
# Copy this file to .env and fill in your API keys

# OpenStreetMap Overpass API (Free - no key required)
# Used for fetching real traffic and restaurant data
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Optional: Weather API for enhanced data correlation
# Get free API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Optional: Nominatim API for geocoding (Free - no key required)
NOMINATIM_API_URL=https://nominatim.openstreetmap.org

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/dashboard.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# Dashboard Configuration
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8050
DEBUG_MODE=False

# MCP Server Configuration
MCP_TIMEOUT=30
MCP_MAX_RETRIES=3

# Data Refresh Intervals (in seconds)
TRAFFIC_REFRESH_INTERVAL=300
RESTAURANT_REFRESH_INTERVAL=600